{
    "manifest_version": 3,
    "name": "YouTube Shorts Normal Player",
    "version": "1.4.3",
    "description": "Plays YouTube Shorts in the normal YouTube player so you can rewind the videos.",
    "icons": { "48": "images/icon-48.png", "128": "images/icon-128.png" },
    "browser_specific_settings": {
        "gecko": {
            "id": "{1585f20b-4ee0-4f94-b48a-3719b091df78}",
            "strict_min_version": "113.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "permissions": ["declarativeNetRequestWithHostAccess"],
    "host_permissions": ["*://*.youtube.com/*"],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "shorts_redirect",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["main.js"],
            "run_at": "document_start"
        }
    ]
}

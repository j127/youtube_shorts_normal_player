{
    "name": "youtube_shorts_normal_player",
    "version": "1.5.0",
    "license": "MIT",
    "scripts": {
        "clean": "rm -rf _build",
        "dev": "bun run build && concurrently 'web-ext run --source-dir _build/firefox' 'web-ext run -t chromium --source-dir _build/chrome'",
        "dev:firefox": "bun run build && web-ext run --source-dir _build/firefox",
        "dev:chrome": "bun run build && web-ext run -t chromium --source-dir _build/chrome",
        "dev:mobile": "web-ext run --target=firefox-android",
        "build": "./scripts/build.sh",
        "format": "prettier --write '**/*.{md,mdx,ts,js,mjs,cjs,jsx,tsx,yaml,yml,json,html,css,scss,vue,astro}'"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/bun": "1.3.14",
        "concurrently": "^10.0.0",
        "prettier": "^3.8.3",
        "web-ext": "^10.3.0",
        "typescript": "^6.0.3"
    }
}
